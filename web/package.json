{
  "name": "vohub-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint src",
    "test:contract": "node scripts/check-api-contract.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run test:contract && node scripts/build-vohive-clone.mjs",
    "build:legacy-react": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "1.18.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
